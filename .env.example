# =====================================================================
# 🌡 Погодный бот Polymarket — переменные окружения.
# Локально — скопируй в .env, на Coolify — задай в Environment Variables.
#
# Обязательны только TELEGRAM_BOT_TOKEN и TELEGRAM_CHAT_ID. Ключи кошелька не
# нужны: бот ничего не покупает. Остальное — стартовые значения: дальше
# настройки меняются кнопками в Telegram и хранятся в базе data/weather.db.
# =====================================================================

# --- Telegram (обязательно) ---
# Токен НОВОГО бота от @BotFather (один токен — один бот)
TELEGRAM_BOT_TOKEN=
# Твой chat id: туда идут сообщения и файлы, и только этот чат может управлять ботом
TELEGRAM_CHAT_ID=

# --- API Polymarket (публичные) ---
GAMMA_HOST=https://gamma-api.polymarket.com
CLOB_HOST=https://clob.polymarket.com
# Не чаще стольких запросов в секунду на все API вместе (архив — десятки тысяч запросов)
HTTP_RPS=8
# Теги Gamma, по которым ещё ищем температурные события (плюс поиск по названию)
DISCOVERY_TAGS=temperature,weather,daily-temperature

# --- 📚 Архив закрытых рынков ---
# Глубина архива, дней (кнопками 60/120/240/365)
ARCHIVE_DAYS=120
# Как часто докачивать новое, часов
ARCHIVE_REFRESH_HOURS=6
# Шаг истории цены, минут (нет данных с таким шагом — бот возьмёт 15, 60 или 180)
PATH_FIDELITY_MIN=5

# --- 📊 Пороги ---
# Уровни цены: «цена впервые дошла до X → выиграла ли сторона»
STUDY_LEVELS=0.80,0.83,0.85,0.87,0.90,0.92,0.94,0.96
# Вход = цена в истории + столько (ask выше середины спреда)
STUDY_SLIP=0.01
# Цена перепрыгнула уровень больше чем на столько — по уровню было не войти
STUDY_MAX_JUMP=0.05
# Комиссия тейкера погодных рынков: сумма × FEE_RATE × (1 − цена)
FEE_RATE=0.05
# Правило «проверено»: ставок не меньше RULE_MIN_N; на старой части архива (60% дней)
# выигрышей значимо больше окупаемости (p ≤ RULE_MAX_P); на новой — в плюсе;
# в каждой части не меньше RULE_MIN_PART_N ставок
RULE_MIN_N=30
RULE_MIN_PART_N=10
RULE_MAX_P=0.05
# События с меньшим объёмом торгов, $, в расчёт не входят
MIN_EVENT_VOLUME=5000

# --- 🎯 Кандидаты ---
LIVE_ENABLED=true
# Как часто смотреть открытые события, секунд
LIVE_POLL_SEC=60
# Снимок цен открытых рынков в базу — раз в столько минут
SNAPSHOT_EVERY_MIN=10
# Сообщения о кандидатах (кнопкой в 🎯)
ALERTS_ENABLED=true
# Тестовая ставка на кандидата, $
PAPER_STAKE_USDC=10

# --- База и отчёты ---
# На Coolify: постоянный том (Persistent Storage) на /app/data — иначе архив
# качается заново после каждого деплоя
DB_PATH=data/weather.db
REPORTS_DIR=data/reports
# Ежедневная сводка — в этот час UTC
REPORT_HOUR_UTC=6
