TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DATA_DIR=/var/data
PORT=8080
LOG_LEVEL=INFO

# Every strategy gets this independent PAPER bankroll.
PAPER_START_BALANCE=500
MIN_FREE_CASH=5

# Execution realism.
DECISION_INTERVAL=0.25
MAX_BOOK_AGE_MS=1500
MAX_FEED_AGE_MS=1500
PAPER_TAKER_LATENCY_MS=400
ATTEMPT_COOLDOWN_MS=1200

# Source-backed dual-beta regime pair.
ROBUST_BETAS=0.83,1.36

# Adaptation defaults for the source-described fair-value model.
LATE_MODEL_WEIGHT=0.95
TAIL_WEIGHT=0.15
TAIL_SCALE=2.5
VOL_FAST_WINDOW_SEC=60
VOL_SLOW_WINDOW_SEC=600
VOL_FAST_HALFLIFE_SEC=30
VOL_SLOW_HALFLIFE_SEC=300
MIN_VOL_PER_SQRT_SEC=0.00002
BASIS_WINDOW_SEC=60

# Public market-data endpoints. Normally leave unchanged.
BINANCE_SYMBOL=BTCUSDT
BINANCE_DATA_API=https://data-api.binance.vision
BINANCE_SPOT_WS=wss://data-stream.binance.vision/stream?streams=btcusdt@bookTicker/btcusdt@aggTrade
BINANCE_PERP_WS=wss://fstream.binance.com/market/stream?streams=btcusdt@bookTicker/btcusdt@aggTrade
