# =====================================================================
# Бот серий 15m (Polymarket Up/Down) — переменные окружения.
# Локально — скопируй в .env, на Coolify — задай в Environment Variables.
#
# Обязательны только TELEGRAM_BOT_TOKEN и TELEGRAM_CHAT_ID (и POLY_PRIVATE_KEY
# для реальных ставок). Всё остальное — стартовые значения: дальше монеты,
# режим и настройки стратегии меняются кнопками в Telegram (/menu) и хранятся
# в базе data/bot.db. Без постоянного тома на /app/data база при каждом
# деплое создаётся заново — и всё возвращается к значениям отсюда.
# =====================================================================

# --- Telegram (обязательно) ---
TELEGRAM_BOT_TOKEN=
# Твой chat id: туда идут уведомления, и только этот чат может управлять ботом
TELEGRAM_CHAT_ID=

# --- Кошелёк Polymarket (только для реальных ставок) ---
# Приватный ключ кошелька, которым торгуешь. ДЕРЖИ В СЕКРЕТЕ — лучше
# отдельный торговый кошелёк. Без ключа бот работает только в тесте.
POLY_PRIVATE_KEY=
# Нужен, только если торгуешь не с адреса этого ключа (отдельный кошелёк на
# Polymarket). Обычно, и при email/Magic-логине тоже, — пусто.
POLY_FUNDER_ADDRESS=
# API-ключи CLOB для потока цен PolyBolt. Не заданы — бот берёт их из
# SDK-клиента или выводит из POLY_PRIVATE_KEY (только чтение, новых не создаёт).
POLY_API_KEY=
POLY_API_SECRET=
POLY_API_PASSPHRASE=

# --- Режим ---
# Общий выключатель реальных ставок (кнопка 🔴 Включить LIVE / 🧪 Выключить LIVE).
# true — ни одного реального ордера, что бы ни стояло у монет.
DRY_RUN=true

# --- Монеты ---
# Шесть монет с рынками 15m. Обычно не задавай.
ASSETS=btc,eth,sol,xrp,bnb,doge
# Какие монеты включены при старте (✅ — по ним ставит стратегия); пусто — все.
SERIES_COINS=
# Какие монеты сразу 🔴 — реальные ставки по ним, когда DRY_RUN=false
# (или нажат 🔴 Включить LIVE). Пусто — все 🧪, только тест.
# Пример: SERIES_LIVE_COINS=btc,eth
# (ENABLED_ASSETS/LIVE_ASSETS прежнего 5m-бота больше не читаются.)
SERIES_LIVE_COINS=

# --- 🎲 Стратегия: после SERIES_TRADE_K+ одинаковых исходов подряд — ставка на разворот ---
SERIES_TRADE_ENABLED=true
# lead60 — на 60-й секунде окна, если сторона разворота уже ведёт (ask 0.52–0.80),
#          по цене не выше ask + 1¢ (по умолчанию);
# cheap  — первая цена не выше SERIES_TRADE_CAP в первые SERIES_TRADE_ENTRY_SEC секунд.
SERIES_TRADE_RULE=lead60
# Для lead60: с какой цены сторона разворота считается ведущей (кнопки 0.52/0.55/0.58/0.60).
# С v11 — 0.58: по 16–20.10 входы по 0.52–0.56 дали 12 из 22 (около нуля), от 0.60 — 49 из 62.
SERIES_LEAD_MIN=0.58
SERIES_TRADE_K=4
# Ставка в USDC; если по цене входа это меньше 5 акций — ставка поднимается до
# 5 акций (меньший ордер биржа отклоняет): по 0.63 это $3.16.
SERIES_TRADE_USDC=3
# Дневной стоп реальных ставок, USDC (UTC-сутки; 0 — без стопа)
SERIES_TRADE_STOP_USDC=30
# Только для правила cheap: потолок цены и сколько секунд от начала окна ждать
SERIES_TRADE_CAP=0.51
SERIES_TRADE_ENTRY_SEC=60
# На каких окнах ставить (поддерживается 15m)
SERIES_TRADE_INTERVALS=15m

# --- 🔁 Запись окон (цены сторон, путь цены, стакан, исходы) ---
SERIES_TEST_ENABLED=true
SERIES_INTERVALS=15m
# Путь цены — каждые N секунд; с 30 с до старта и первые 90 с — каждые
# SERIES_FINE_STEP_SEC (0 — как всё окно), плюс снимки стакана.
SERIES_PATH_STEP_SEC=5
SERIES_FINE_STEP_SEC=1
# Путь и снимки стакана старше N дней стираются (цены старта и исходы остаются; 0 — хранить всё)
SERIES_PATH_KEEP_DAYS=14

# --- 📚 История и сверка (только расчёт) ---
SERIES_HISTORY_DAYS=365
SERIES_OFFICIAL_DAYS=60
# Цена входа для расчёта по истории
SERIES_ENTRY_PRICE=0.51

# --- Отчёты и база ---
# Раз в N часов — три CSV в Telegram: окна, ставки, варианты входа
REPORT_INTERVAL_HOURS=4
REPORTS_DIR=data/reports
# На Coolify: постоянный том (Persistent Storage) на /app/data — иначе база
# и настройки теряются при каждом деплое
DB_PATH=data/bot.db

# --- Технические (обычно не трогать) ---
POLY_HOST=https://clob.polymarket.com
GAMMA_HOST=https://gamma-api.polymarket.com
POLY_CHAIN_ID=137
# Живой стакан по WebSocket — без него стратегия не работает
USE_LIVE_BOOK_STREAM=true
# Комиссия тейкера: ставка × FEE_RATE × (1 − цена)
FEE_RATE=0.07
# Цена Chainlink — исход окна, если стакан в последние секунды его не показал
CHAINLINK_USE_POLYBOLT=true
CHAINLINK_POLYBOLT_URL=wss://ws-live-v2.polymarket.com/ws
CHAINLINK_USE_RTDS=true
CHAINLINK_RTDS_URL=wss://ws-live-data.polymarket.com
# Свечи Binance для 📚 истории
BINANCE_BASE_URL=https://api.binance.com
BINANCE_FUTURES_URL=https://fapi.binance.com
